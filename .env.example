# 311 Triage Assistant Environment Variables
# Copy to .env and fill in your values

# Required: OpenAI API key for GPT-3.5-turbo
OPENAI_API_KEY=sk-your-key-here

# Optional: SQLite database path (default: data/311.db)
DB_PATH=data/311.db

# Optional: Use OpenAI Batch API for cost savings (true/false)
BATCH_API=false

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
